# 复制成 .env 后按需修改。全部都有合理默认值，不改也能跑。
# 注意：GPU_ID 由 `make up` 自动挑卡填充，不需要（也不建议）写死在这里。

# ---- GPU ----
# 显式指定用哪张卡。留空则由 scripts/pick_gpu.py 自动挑一张空闲卡。
# GPU_ID=3

# ---- 模型 ----
MODEL_ID=Qwen/Qwen-Image-2.1
# 后端加载精度：bfloat16（推荐）| float16 | float32
TORCH_DTYPE=bfloat16
# 默认输出边长。尺寸未指定时用它派生 width/height。
DEFAULT_RESOLUTION=1024

# ---- 显存 ----
# 置 1 则把 pipeline 分步卸载到 CPU，显存不够时能救急，但明显变慢。
# 33GB bf16 权重在 H100 80GB 上有余量，正常不需要开。
CPU_OFFLOAD=0

# ---- 构建 ----
# 本机 docker daemon 不走代理，构建时必须靠这两个参数让容器内的
# apt/pip/uv 走宿主机代理（compose 里已配 build.network: host）。
BUILD_HTTP_PROXY=http://127.0.0.1:7890
BUILD_HTTPS_PROXY=http://127.0.0.1:7890

# ---- 网关并发 ----
# 同步请求与异步 worker 共享这个并发上限。
# 默认 1：diffusers 没有批处理引擎，并发只会互抢显存、拖慢彼此。
MAX_CONCURRENCY=1
# 排队上限，满了返回 429 而不是无限堆积
MAX_QUEUE_DEPTH=32
# 单次生成的超时（秒）。diffusers 单张 1024²/40 步比 SGLang 慢，给宽一点。
REQUEST_TIMEOUT_S=600
# 任务结果保留时长（小时），到期连同图片一起清理
TASK_TTL_HOURS=24

# ---- 对外地址 ----
# 生成 url 模式响应时用的前缀，按实际访问地址改
PUBLIC_BASE_URL=http://localhost:8090

# ---- 兼容性 ----
# 后端 multipart 参考图的字段名。
EDIT_IMAGE_FIELD=image
